  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Standard native action control.",
      "html": "<button class=\"ds-primary\">Create my designs</button>",
      "css": ".ds-primary{min-height:44px;padding:8px 16px;border-radius:4px;font:600 .875rem Hanken,system-ui,sans-serif;cursor:pointer;transition:background-color 120ms cubic-bezier(.16,1,.3,1);background:var(--color-accent);border:1px solid var(--color-accent);color:var(--color-ink)}.ds-primary:hover{background:color-mix(in srgb,var(--color-accent) 85%,var(--color-paper))}.ds-primary:focus-visible{outline:2px solid var(--color-focus);outline-offset:2px}.ds-primary:active{transform:translateY(1px)}.ds-primary:disabled{background:var(--color-paper-3);color:var(--color-muted);cursor:wait}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Standard native action control.",
      "html": "<button class=\"ds-secondary\">Create my designs</button>",
      "css": ".ds-secondary{min-height:44px;padding:8px 16px;border-radius:4px;font:600 .875rem Hanken,system-ui,sans-serif;cursor:pointer;transition:background-color 120ms cubic-bezier(.16,1,.3,1);background:transparent;border:1px solid var(--color-rule);color:var(--color-ink)}.ds-secondary:hover{background:var(--color-paper-2)}.ds-secondary:focus-visible{outline:2px solid var(--color-focus);outline-offset:2px}.ds-secondary:active{transform:translateY(1px)}.ds-secondary:disabled{background:var(--color-paper-3);color:var(--color-muted);cursor:wait}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "description": "Standard native action control.",
      "html": "<button class=\"ds-quiet\">Create my designs</button>",
      "css": ".ds-quiet{min-height:44px;padding:8px 16px;border-radius:4px;font:600 .875rem Hanken,system-ui,sans-serif;cursor:pointer;transition:background-color 120ms cubic-bezier(.16,1,.3,1);background:transparent;border:1px solid transparent;color:var(--color-ink)}.ds-quiet:hover{background:var(--color-paper-2)}.ds-quiet:focus-visible{outline:2px solid var(--color-focus);outline-offset:2px}.ds-quiet:active{transform:translateY(1px)}.ds-quiet:disabled{background:var(--color-paper-3);color:var(--color-muted);cursor:wait}"
    },

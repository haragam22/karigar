  "narrative": {
    "northStar": "The showroom workbench",
    "overview": "The showroom workbench puts the actual jewellery beside its measured gold. Atelier-derived serif typography and warm, sparse surfaces provide showroom luxury; familiar controls and tabular figures keep this an Operate-mode tool.\n\nVisual ambition comes from the engine-generated object: a real GLB where available, with the actual render as poster or fallback. The interface keeps the customer’s Hinglish request, assumptions and numeric sources visible.",
    "keyCharacteristics": [
      "Object-led composition with a dark jewellery stage.",
      "Quiet warm surfaces, gold actions and ink navigation.",
      "Serif headings, sans controls and tabular measurements."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Sources, timestamps, assumptions and sample labels remain readable beside the numbers they qualify.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do retain the pinned ink, gold and warm-white palette.",
      "Do use real engine GLBs and renders with meaningful descriptions.",
      "Do keep sources, timestamps, assumptions and sample-data labels visible.",
      "Do preserve native controls, keyboard focus and in-progress input."
    ],
    "donts": [
      "Don't replace actual jewellery with decorative placeholder imagery.",
      "Don't turn every section into a shadowed card.",
      "Don't use status color without its text label.",
      "Don't imply that local demo review certifies production or every project phase."
    ]
  },

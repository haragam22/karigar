      "css": ".ds-label{display:block;margin-bottom:8px;font:600 .875rem Hanken,system-ui,sans-serif}.ds-field{width:100%;min-height:125px;padding:12px;border:1px solid var(--color-muted);border-radius:4px;background:var(--color-paper);color:var(--color-ink);font:1rem Hanken,system-ui,sans-serif;resize:vertical}.ds-field:focus-visible{outline:2px solid var(--color-focus);outline-offset:2px}"
    },

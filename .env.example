# Copy to .env (git-ignored) and fill in. Read by karigar/core/llm.py.
# LLM backend: auto | agentrouter | anthropic | none   (auto = agentrouter if its key is set)
KARIGAR_LLM_BACKEND=auto
AGENTROUTER_API_KEY=
# Anthropic-style base URL for the claude CLI (not the OpenAI /v1 path)
AGENTROUTER_BASE_URL=https://agentrouter.org
KARIGAR_MODEL=gpt-6.1-sol
# Seconds before the deterministic fallback answers instead
KARIGAR_LLM_TIMEOUT_S=45
# Path to the Claude Code CLI if it isn't on PATH
KARIGAR_CLAUDE_BIN=claude
# Owner/staff sender IDs (comma-separated) allowed to set the gold rate in chat.
# Empty = nobody; chat rate messages are refused. Rates come from data/gold_rates.json.
KARIGAR_RATE_SETTERS=

# --- Phase 7 service (Render env vars; never commit real values) ---
# Key the Nonilion "Other" import sends as its API key
KARIGAR_API_KEY=
# Shared between the Render service and the laptop worker; must differ from KARIGAR_API_KEY
KARIGAR_WORKER_TOKEN=
# Required to use the console. Must differ from API and worker tokens.
KARIGAR_OWNER_TOKEN=
# Service only: public https base for file links (Render sets RENDER_EXTERNAL_URL itself)
KARIGAR_PUBLIC_URL=
# --- Phase 7 worker (laptop / WSL) ---
# The Render service the worker polls, e.g. https://karigar.onrender.com
KARIGAR_SERVICE_URL=
# draft | preview | final
KARIGAR_WORKER_QUALITY=draft
# Optional workshop id for learned casting loss
KARIGAR_WORKSHOP=
# Optional paths for isolated workshop/runtime data
KARIGAR_CALIBRATION_FILE=
KARIGAR_ORDERS_DB=
